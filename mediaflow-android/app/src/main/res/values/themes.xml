<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="mf_ink">#FF10121B</color>

    <style name="Theme.MediaFlow" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/mf_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.MediaFlow.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mf_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MediaFlow</item>
    </style>
</resources>
