<?xml version='1.0' encoding='utf-8'?>
<widget id="com.personal.gymtrack" version="2.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>Forma</name>
    <description>Seguimiento de gimnasio, agua, proteína y pasos</description>
    <content src="index.html" />
    <icon src="icon.png" />
    <access origin="*" />
    <preference name="Orientation" value="portrait" />
    <preference name="BackgroundColor" value="0xff0a0a0b" />
    <preference name="AndroidWindowSplashScreenBackground" value="#0a0a0b" />
    <preference name="StatusBarBackgroundColor" value="#0a0a0b" />
    <platform name="android">
        <preference name="android-minSdkVersion" value="26" />
        <preference name="android-targetSdkVersion" value="35" />
        <config-file target="AndroidManifest.xml" parent="/*">
            <uses-permission android:name="android.permission.health.READ_STEPS" />
            <uses-permission android:name="android.permission.VIBRATE" />
        </config-file>
    </platform>
</widget>
